{
    "column_formats": [
        {
            "_comment": "Primary IDs are bold and centered.",
            "align": "center",
            "bold": true,
            "index": 0,
            "width": 10
        },
        {
            "_comment": "Demonstrates automatic suffixing for category labels.",
            "index": 1,
            "italic": true,
            "suffix": ": ",
            "width": 20
        },
        {
            "_comment": "Native Excel dropdown list.",
            "index": 4,
            "validation": {
                "input_message": "Select from the list",
                "input_title": "Choose Status:",
                "source": [
                    "Passed",
                    "Failed",
                    "In Progress",
                    "Not Started"
                ],
                "validate": "list"
            },
            "width": 25
        }
    ],
    "columns": [
        "Item ID",
        "Category",
        "Target Value",
        "Current Status",
        "Validation Test",
        "Deadline"
    ],
    "conditional_formats": [
        {
            "index": 2,
            "rules": [
                {
                    "_comment": "Predefined coloring for numeric thresholds.",
                    "criteria": ">",
                    "format": "green",
                    "type": "cell",
                    "value": 50
                }
            ]
        },
        {
            "index": 3,
            "rules": [
                {
                    "_comment": "Keyword matching to trigger styles.",
                    "criteria": "containing",
                    "format": "yellow",
                    "type": "text",
                    "value": "Alert"
                }
            ]
        },
        {
            "index": 5,
            "rules": [
                {
                    "_comment": "Dynamic formula-based rule for overdue items.",
                    "criteria": "=AND(F2<>\"\", F2<TODAY())",
                    "format": "alert_red",
                    "type": "formula"
                }
            ]
        }
    ],
