    "conditional_formats": [
        {
            "index": [
                3,
                4,
                5,
                6,
                7
            ],
            "rules": [
                {
                    "criteria": "containing",
                    "format": "green",
                    "type": "text",
                    "value": "On File"
                },
                {
                    "criteria": "not containing",
                    "format": "yellow",
                    "type": "text",
                    "value": "On File"
                },
                {
                    "format": "yellow",
                    "type": "blanks"
                }
            ]
        },
        {
            "index": 8,
            "rules": [
                {
                    "criteria": "containing",
                    "format": "yellow",
                    "type": "text",
                    "value": "Pending"
                },
                {
                    "format": "yellow",
                    "type": "blanks"
                },
                {
                    "criteria": "not containing",
                    "format": "green",
                    "type": "text",
                    "value": "Pending"
                }
            ]
        },
        {
            "index": 9,
            "rules": [
                {
                    "criteria": "containing",
                    "format": "yellow",
                    "type": "text",
                    "value": "TBD"
                },
                {
                    "criteria": "containing",
                    "format": "yellow",
                    "type": "text",
                    "value": "Pending"
                },
                {
                    "format": "yellow",
                    "type": "blanks"
                },
                {
                    "criteria": "=AND(ISBLANK(J2)=FALSE, ISNUMBER(SEARCH(\"TBD\", J2))=FALSE, ISNUMBER(SEARCH(\"Pending\", J2))=FALSE)",
                    "format": "green",
                    "type": "formula"
                }
            ]
        }
    ],
